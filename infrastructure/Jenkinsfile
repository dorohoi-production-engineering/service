pipeline {
    agent any

    tools {
        jdk 'jdk21' // Numele trebuie să coincidă cu cel din Jenkins > Global Tool Configuration
    }

    environment {
        DOCKER_PASSWORD = credentials("docker_password")
    }

    stages {
        stage('Build & Test') {
            steps {
                sh './gradlew clean build'
            }
        }
    }
}
